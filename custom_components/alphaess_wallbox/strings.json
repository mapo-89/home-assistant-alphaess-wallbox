{
  "title": "AlphaESS Wallbox",
  "config": {
    "step": {
      "user": {
        "title": "Connect AlphaESS Wallbox",
        "description": "Credentials are stored in the Home Assistant config entry. Access and refresh tokens are kept in memory and never exposed as entity attributes.",
        "data": {
          "username": "Username",
          "password": "Password",
          "system_sn": "System serial number",
          "charger_sn": "EV charger serial number (optional for one charger)",
          "scan_interval": "Scan interval (seconds)"
        }
      }
    },
    "error": {
      "cannot_connect": "Cannot connect to AlphaESS",
      "invalid_auth": "Invalid credentials",
      "unknown": "Unexpected AlphaESS response"
    },
    "abort": {
      "already_configured": "This system is already configured"
    }
  },
  "entity": {
    "sensor": {
      "charging_mode": {"name": "Charging mode"},
      "api_status": {"name": "API status"}
    },
    "select": {
      "charging_mode": {
        "name": "Charging mode",
        "state": {
          "eco_slow": "ECO: Slow",
          "eco_gentle": "ECO: Gentle charging",
          "eco_fast": "ECO: Fast",
          "maximum_power": "Maximum power"
        }
      }
    }
  }
}
